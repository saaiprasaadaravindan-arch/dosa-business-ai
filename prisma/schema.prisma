generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER_ADMIN INVESTOR MANAGER EMPLOYEE }
enum PropertyType { FACTORY WAREHOUSE OFFICE }
enum PartnerStatus { PROSPECT ACTIVE INACTIVE }
enum OrderStatus { DRAFT CONFIRMED FULFILLED CANCELLED }
enum DeliveryStatus { PLANNED IN_TRANSIT DELIVERED CANCELLED }
enum ReportStatus { DRAFT PUBLISHED ARCHIVED }

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]  @relation("OrderCreator")
}

model Property {
  id          String       @id @default(cuid())
  name        String
  type        PropertyType
  address     String
  floorAreaM2 Decimal?     @db.Decimal(10, 2)
  monthlyRent Decimal?     @db.Decimal(12, 2)
  currency    String       @default("PLN")
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Supplier {
  id          String        @id @default(cuid())
  name        String
  country     String?
  status      PartnerStatus @default(PROSPECT)
  contactName String?
  email       String?
  phone       String?
  notes       String?
  ingredients IngredientSupplier[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Ingredient {
  id        String               @id @default(cuid())
  name      String
  unit      String
  notes     String?
  suppliers IngredientSupplier[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model IngredientSupplier {
  ingredientId String
  supplierId   String
  supplierSku  String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([ingredientId, supplierId])
}

model BusinessCost {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("PLN")
  incurredOn  DateTime
  recurring   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        String        @id @default(cuid())
  name      String
  status    PartnerStatus @default(PROSPECT)
  email     String?
  phone     String?
  address   String?
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  createdById String?
  status      OrderStatus @default(DRAFT)
  total       Decimal?    @db.Decimal(14, 2)
  currency    String      @default("PLN")
  orderedAt   DateTime    @default(now())
  customer    Customer    @relation(fields: [customerId], references: [id])
  createdBy   User?       @relation("OrderCreator", fields: [createdById], references: [id])
  delivery    Delivery?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  status      DeliveryStatus @default(PLANNED)
  scheduledAt DateTime?
  deliveredAt DateTime?
  notes       String?
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ResearchReport {
  id        String       @id @default(cuid())
  title     String
  status    ReportStatus @default(DRAFT)
  content   String?
  sources   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model FinancialScenario {
  id          String   @id @default(cuid())
  name        String
  assumptions Json
  results     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
